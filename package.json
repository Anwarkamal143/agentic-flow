{
  "name": "s-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tests",
    "lint": "eslint . && prettier --check . && pnpm --filter @factory/db db:check",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "vitest run tests/scenarios",
    "factory": "node apps/cli/dist/main.js",
    "fixtures": "node fixtures/create-tiny-ts.mjs"
  },
  "devDependencies": {
    "@factory/domain": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
